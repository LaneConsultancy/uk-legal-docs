{
  "rewrites": [
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/gumroad(.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.getlegaldocs.co.uk"
        }
      ],
      "destination": "https://getlegaldocs.co.uk/:path",
      "permanent": true
    }
  ]
}
